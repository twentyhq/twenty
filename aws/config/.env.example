# Twenty CRM Environment Configuration Template
# Copy this file to .env and fill in the values

# ===========================================
# Server Configuration
# ===========================================
SERVER_URL=https://your-domain.com
PORT=3000

# ===========================================
# Database Configuration
# ===========================================
# Format: postgresql://username:password@host:port/dbname
PG_DATABASE_URL=postgresql://twentyadmin:your-password@your-rds-endpoint:5432/twenty
PG_DATABASE_PASSWORD=your-strong-password

# ===========================================
# Redis Configuration
# ===========================================
# Format: redis://host:port
REDIS_URL=redis://your-elasticache-endpoint:6379

# ===========================================
# Security
# ===========================================
# Generate with: openssl rand -base64 32
# IMPORTANT: Keep this secret! Losing it means losing access to all encrypted data
ENCRYPTION_KEY=your-generated-encryption-key

# Token configuration (required for Twenty)
LOGIN_TOKEN_EMAIL={SERIES_NUMBER}
LOGIN_TOKEN_KEY={SERIES_NUMBER}

# ===========================================
# AWS S3 Storage
# ===========================================
STORAGE_TYPE=s3
STORAGE_S3_REGION=us-east-1
STORAGE_S3_BUCKET=twenty-crm-files
STORAGE_S3_ACCESS_KEY_ID=your-access-key
STORAGE_S3_SECRET_ACCESS_KEY=your-secret-key

# ===========================================
# Application Settings
# ===========================================
# Use database for configuration (recommended for production)
IS_CONFIG_VARIABLES_IN_DB_ENABLED=true

# Multi-workspace mode (set to true for SaaS deployments)
IS_MULTIWORKSPACE_ENABLED=false

# ===========================================
# Logging
# ===========================================
NODE_ENV=production
LOG_LEVEL=info

# ===========================================
# Optional: Email Configuration
# ===========================================
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.gmail.com
# EMAIL_SMTP_PORT=465
# EMAIL_SMTP_USER=your-email@gmail.com
# EMAIL_SMTP_PASSWORD=your-app-password

# ===========================================
# Optional: Google OAuth (for Gmail/Calendar)
# ===========================================
# MESSAGING_PROVIDER_GMAIL_ENABLED=true
# CALENDAR_PROVIDER_GOOGLE_ENABLED=true
# AUTH_GOOGLE_CLIENT_ID=your-client-id
# AUTH_GOOGLE_CLIENT_SECRET=your-client-secret
# AUTH_GOOGLE_CALLBACK_URL=https://your-domain.com/auth/google/redirect
# AUTH_GOOGLE_APIS_CALLBACK_URL=https://your-domain.com/auth/google-apis/get-access-token

# ===========================================
# Optional: Microsoft OAuth
# ===========================================
# MESSAGING_PROVIDER_MICROSOFT_ENABLED=true
# CALENDAR_PROVIDER_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_ENABLED=true
# AUTH_MICROSOFT_CLIENT_ID=your-client-id
# AUTH_MICROSOFT_CLIENT_SECRET=your-client-secret
# AUTH_MICROSOFT_CALLBACK_URL=https://your-domain.com/auth/microsoft/redirect
# AUTH_MICROSOFT_APIS_CALLBACK_URL=https://your-domain.com/auth/microsoft-apis/get-access-token

# ===========================================
# Optional: Lambda (for logic functions)
# ===========================================
# LOGIC_FUNCTION_TYPE=LAMBDA
# LOGIC_FUNCTION_LAMBDA_REGION=us-east-1
# LOGIC_FUNCTION_LAMBDA_ROLE=arn:aws:iam::123456789:role/your-lambda-role
