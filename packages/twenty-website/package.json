    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "vinext start --port 3002",
    "deploy:vinext:dev": "vinext-cloudflare deploy --env dev",
    "deploy:vinext:prod": "vinext-cloudflare deploy --env prod"
  },
