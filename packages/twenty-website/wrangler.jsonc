{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "twenty-website",
  "compatibility_date": "2026-04-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
  "env": {
    "dev": {
      "name": "twenty-website-dev",
      "routes": [
        {
          "pattern": "twenty-main.com",
          "custom_domain": true,
        },
        {
          "pattern": "www.twenty-main.com",
          "custom_domain": true,
        },
      ],
      // Backs the Next data cache. The route-level ISR cache is the Workers
      // Cache API and needs no binding.
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
          "id": "<dev-kv-namespace-id>",
        },
      ],
    },
    "prod": {
      "name": "twenty-website-prod",
      "routes": [
        {
          "pattern": "twenty.com",
          "custom_domain": true,
        },
        {
          "pattern": "www.twenty.com",
          "custom_domain": true,
        },
      ],
      "kv_namespaces": [
        {
          "binding": "VINEXT_KV_CACHE",
          "id": "<prod-kv-namespace-id>",
        },
      ],
    },
  },
}
