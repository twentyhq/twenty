{
  "$schema": "../../node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["eslint-plugin-lingui"],
  "categories": {
    "correctness": "off"
  },
  "rules": {
    "lingui/no-unlocalized-strings": [
      "error",
      {
        "ignore": [
          "^\\s*$",
          "^\\d+(\\.\\d+)?(px|rem|em|%|vh|vw|s|ms)?$",
          "^#[0-9a-fA-F]{3,8}$",
          "^https?://",
          "^Icon[A-Z]\\w*$",
          "^[A-Z][A-Za-z0-9]*(Configuration|Position|Edge|GroupBy)$",
          "^[A-Z][A-Za-z0-9]*[a-z][A-Z][A-Za-z0-9]*$",
          "^(IMAP|SMTP|CALDAV)\\.",
          "^(?:\\d+(?:\\.\\d+)?(?:px|fr|rem|em|%)\\b|minmax\\(|repeat\\(|calc\\(|var\\(|max\\(|rgba\\(|cubic-bezier\\()",
          "^(?:autoplay;|color:|background:|font-|opacity:|transform:|transition:|animation:)",
          "^\\d+(?:\\.\\d+)?s(?:,|$)",
          "^Bearer(?:\\s|$)",
          "^use (client|server)$",
          "^Aa$",
          "^Ada$",
          "^(stdout|stderr|SOC2|GDPR|OIDC|SAML)$",
          "^Twenty$",
          "^Twenty-DPA-",
          "^(?:M{1,4}\\s+d{1,4}|d{1,4}\\s+M{1,4})$",
          "^LR$",
          "^(GET|POST|PUT|PATCH|DELETE|HEAD|OPTIONS)$"
        ],
        "ignoreNames": [
          "className",
          "data-testid",
          "testId",
          "__typename",
          "id",
          "itemId",
          "key",
          "category",
          "type",
          "icon",
          "iconName",
          "src",
          "href",
          "path",
          "target",
          "rel",
          "htmlFor",
          "width",
          "height",
          "fill",
          "stroke",
          "viewBox",
          "d",
          "transform",
          "color",
          "colorSeed",
          "variant",
          "size",
          "position",
          "align",
          "justify",
          "direction",
          "orientation",
          "status",
          "state",
          "mode",
          "css",
          "gridAutoColumns",
          "mobileGridAutoColumns",
          "gridTemplateColumns",
          "gridTrack",
          "shortcut",
          "accept",
          "query",
          "scopes",
          "mutation",
          "fragment"
        ],
        "ignoreFunctions": [
          "console.*",
          "doNotTranslate",
          "logDebug",
          "logError",
          "assertUnreachable",
          "createRequiredContext",
          "isWidgetConfigurationOfType",
          "getByPrefixAndKey",
          "getAllByPrefixAndKey",
          "*.getAttribute",
          "require",
          "styled",
          "css",
          "keyframes"
        ]
      }
    ]
  }
}
