{
  "name": "twenty-agent-skills",
  "version": "0.1.0",
  "description": "Harness-agnostic Agent Skills for creating, developing, operating, and publishing Twenty apps.",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0",
  "scripts": {
    "build": "node ./scripts/build.js",
    "validate": "node ./scripts/validate-source.js && node ./scripts/build.js && node ./scripts/validate-distribution.js",
    "test": "node --test ./scripts/__tests__/*.spec.js",
    "verify:install": "node ./scripts/verify-install.js",
    "setup:mcp": "bash ./scripts/setup-mcp.sh"
  },
  "files": [
    ".codex-plugin",
    ".mcp.json",
    "AGENTS.md",
    "README.md",
    "assets",
    "references",
    "skills",
    "scripts/setup-mcp.sh"
  ],
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": ">=4.0.2"
  }
}
