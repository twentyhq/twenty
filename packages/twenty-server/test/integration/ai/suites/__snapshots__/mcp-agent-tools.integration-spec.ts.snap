                  },
                  "settings": {
                    "properties": {
                      "batchMode": {
                        "description": "When true, events fired close together are grouped into a single run.",
                        "type": "boolean",
                      },
                      "eventName": {
                        "description": "'<objectNameSingular>.<action>' where action is created, updated, deleted, destroyed, restored or upserted (e.g. 'opportunity.created'). Wildcards are not allowed.",
                        "pattern": "^[a-z][a-zA-Z0-9]*\\.(created|updated|deleted|destroyed|restored|upserted)$",
                        "type": "string",
                      },
                      "updatedFields": {
                        "description": "Only for '.updated' events: field names that must change for the trigger to fire.",
                        "items": {
                          "minLength": 1,
                          "type": "string",
                        },
                        "type": "array",
                      },
                    },
                    "required": [
                      "eventName",
                    ],
                    "type": "object",
                  },
                  "type": {
                    "const": "DATABASE_EVENT",
                    "type": "string",
                  },
                },
                "required": [
                  "type",
                  "settings",
                ],
                "type": "object",
              },
