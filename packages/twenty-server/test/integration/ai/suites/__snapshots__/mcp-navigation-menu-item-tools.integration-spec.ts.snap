          "type": "object",
        },
      ],
    },
    "name": "create_navigation_menu_item",
  },
  {
    "description": "Update a navigation menu item (rename, recolor, move between folders, reorder). Type and target ids are immutable — delete and recreate to convert one variant into another.",
    "inputSchema": {
      "properties": {
        "color": {
          "description": "New hex colour",
          "type": "string",
        },
        "folderId": {
          "anyOf": [
            {
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "Move into a different folder. Pass null to move to the top level.",
        },
        "icon": {
          "description": "New icon identifier",
          "type": "string",
        },
        "id": {
          "description": "Id of the navigation menu item to update",
          "format": "uuid",
          "type": "string",
        },
        "link": {
          "description": "New URL (only meaningful for LINK items)",
          "format": "uri",
          "type": "string",
        },
        "name": {
          "description": "New display name. For OBJECT/VIEW/RECORD items the sidebar normally shows the target entity's own name — only set this if the user wants a custom label.",
          "minLength": 1,
          "type": "string",
        },
        "pageLayoutId": {
          "description": "New page layout id (only meaningful for PAGE_LAYOUT items)",
          "type": "string",
        },
        "position": {
          "description": "New position among siblings",
          "type": "number",
        },
      },
      "required": [
        "id",
      ],
      "type": "object",
    },
    "name": "update_navigation_menu_item",
  },
  {
    "description": "Delete a navigation menu item. Deleting a folder also deletes everything inside it.",
    "inputSchema": {
      "properties": {
        "id": {
          "description": "Id of the navigation menu item to delete",
          "format": "uuid",
          "type": "string",
        },
      },
      "required": [
