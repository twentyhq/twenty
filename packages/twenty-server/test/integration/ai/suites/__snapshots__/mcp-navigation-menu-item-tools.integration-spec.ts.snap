            },
            "scope": {
              "$ref": "#/$defs/__schema0",
            },
            "targetObjectMetadataId": {
              "description": "Id of the record's object metadata",
              "format": "uuid",
              "type": "string",
            },
            "targetRecordId": {
              "description": "Id of the record to pin",
              "format": "uuid",
              "type": "string",
            },
            "type": {
              "const": "RECORD",
              "type": "string",
            },
          },
          "required": [
            "type",
            "scope",
            "targetRecordId",
            "targetObjectMetadataId",
          ],
          "type": "object",
        },
        {
          "properties": {
            "color": {
              "$ref": "#/$defs/__schema3",
            },
            "folderId": {
              "$ref": "#/$defs/__schema5",
            },
            "icon": {
              "$ref": "#/$defs/__schema2",
            },
            "name": {
              "$ref": "#/$defs/__schema1",
            },
            "pageLayoutId": {
              "description": "Id of the page layout to pin",
              "type": "string",
            },
