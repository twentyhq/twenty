exports[`Application page layout filters update should fail when the workspace changes the filters of a standard dashboard 1`] = `
{
  "extensions": {
    "code": "BAD_USER_INPUT",
    "userFriendlyMessage": "The filters of this dashboard come from its application and cannot be changed.",
  },
  "message": "Filters of page layout "<pageLayoutId>" are defined by its application and cannot be changed",
  "name": "UserInputError",
}
`;

exports[`Page layout with filters update should fail when a default value holds the object form of a relative date 1`] = `
{
  "extensions": {
    "code": "METADATA_VALIDATION_FAILED",
    "errors": {
      "pageLayout": [
        {
          "errors": [
            {
              "code": "INVALID_PAGE_LAYOUT_DATA",
              "message": "Value "{"direction":"PAST","amount":1,"unit":"MONTH"}" of the default value of dashboard filter "Period" is not valid for operand "IS_RELATIVE". Expected a stringified relative date such as "NEXT_30_DAY".",
              "userFriendlyMessage": "Dashboard filter default value is not valid for this operand",
              "value": "{"direction":"PAST","amount":1,"unit":"MONTH"}",
            },
          ],
          "flatEntityMinimalInformation": {
            "universalIdentifier": Any<String>,
          },
          "metadataName": "pageLayout",
          "status": "fail",
          "type": "update",
        },
      ],
    },
    "message": "Validation failed for 1 pageLayout",
    "summary": {
      "pageLayout": 1,
      "totalErrors": 1,
    },
    "userFriendlyMessage": "Dashboard filter default value is not valid for this operand",
  },
  "message": "Multiple validation errors occurred while updating page layout with tabs",
  "name": "GraphQLError",
}
`;

