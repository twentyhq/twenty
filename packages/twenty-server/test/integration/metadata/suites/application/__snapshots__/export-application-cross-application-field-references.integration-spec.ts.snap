  "extensions": {
    "code": "BAD_USER_INPUT",
    "subCode": "REQUIRED_APPLICATION_NOT_SATISFIED",
    "userFriendlyMessage": "This application requires another application that is not installed in this workspace, or not at a compatible version.",
  },
  "message": "Application "Cross App Declaring Consumer" cannot be synced: application d3e4f5a6-0040-4b7c-8d9e-0f1a2b3c4d5e (*) is not installed",
  "name": "UserInputError",
}
`;

exports[`Application sync - declared required applications refuses to sync when the installed version does not satisfy the declared range 1`] = `
{
  "extensions": {
    "code": "BAD_USER_INPUT",
    "subCode": "REQUIRED_APPLICATION_NOT_SATISFIED",
    "userFriendlyMessage": "This application requires another application that is not installed in this workspace, or not at a compatible version.",
  },
  "message": "Application "Cross App Declaring Consumer" cannot be synced: application "Cross App Declared Dependency" (d3e4f5a6-0020-4b7c-8d9e-0f1a2b3c4d5e) is installed at version 1.0.0, which does not satisfy ^2.0.0",
  "name": "UserInputError",
}
`;

exports[`Application sync - declared required applications refuses to uninstall an application that another installed application requires 1`] = `
