{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": {
      "twenty-ui/icon": ["../twenty-ui/src/icon/index.ts"],
      "@ui/*": ["../twenty-ui/src/*"],
      "@assets/*": ["../twenty-ui/src/assets/*"],
      "@styles/*": ["../twenty-ui/src/styles/*"],
      "@test-utilities/*": ["../twenty-ui/src/test-utilities/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
