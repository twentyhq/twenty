{
  "name": "twenty-utils",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/twenty-utils",
  "projectType": "application",
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": [
        "^default",
        "excludeStories",
        "{workspaceRoot}/jest.preset.js"
      ],
      "outputs": ["{projectRoot}/coverage"],
      "options": {
        "cwd": "{projectRoot}",
        "command": "jest --config ./jest.config.mjs --silent --coverageReporters=text-summary --cacheDirectory=../../.cache/jest/{projectRoot}"
      },
      "configurations": {
        "ci": {
          "command": "jest --config ./jest.config.mjs --silent --coverageReporters=text-summary --cacheDirectory=../../.cache/jest/{projectRoot} --ci --maxWorkers=1 --coverage"
        },
        "coverage": {
          "command": "jest --config ./jest.config.mjs --silent --coverageReporters=lcov --coverageReporters=text --cacheDirectory=../../.cache/jest/{projectRoot} --coverage"
        },
        "watch": {
          "command": "jest --config ./jest.config.mjs --silent --coverageReporters=text-summary --cacheDirectory=../../.cache/jest/{projectRoot} --watch"
        }
      }
    }
  }
}
