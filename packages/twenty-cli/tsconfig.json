{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": false,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@create-twenty-app/*": ["../create-twenty-app/src/*"]
    }
  },
  "include": ["src/**/*.ts", "vite.config.ts", "vitest.config.ts"]
}
