TAG=v2.52.0
DOMAIN=crm.skilland.ai

# Generated by deploy.sh on first run — do not commit actual values
# APP_SECRET=
# PG_DATABASE_PASSWORD=

# Email — optional. Without these, EMAIL_DRIVER falls back to LOGGER and Twenty
# writes outgoing mail to the server log instead of sending it, which silently
# disables invitations, password resets and email verification.
#
# Port 587 (STARTTLS), not 465: Twenty never sets nodemailer's `secure` flag,
# so a 465 connection would attempt plaintext against a TLS-only port.
# Quote EMAIL_FROM_NAME — an unquoted space breaks shell sourcing of this file.
#
# EMAIL_DRIVER=smtp
# EMAIL_SMTP_HOST=smtp.resend.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_USER=resend
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM_ADDRESS=noreply@send.example.com
# EMAIL_FROM_NAME="Example CRM"

# At-rest encryption key (Twenty v2.5+). Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
