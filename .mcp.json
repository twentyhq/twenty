{
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "bash",
      "args": ["-c", "source packages/twenty-server/.env && npx -y @modelcontextprotocol/server-postgres \"$PG_DATABASE_URL\""],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--no-sandbox", "--headless"],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "twenty_prod": {
      "url": "http://crm.lan/mcp_disable",
      "type": "http",
      "bearer_token_env_var": "TWENTY_PROD_MCP_TOKEN"
    },
    "twenty_stage": {
      "url": "http://crm-stage.lan/mcp",
      "type": "http",
      "http_headers_helper": "/bin/zsh /Users/evgenijaleksandrov/Desktop/repo/repo/Kate/crm/crm-twenty/scripts/get-twenty-stage-mcp-headers.sh"
    }
  }
}
