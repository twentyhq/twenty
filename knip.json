{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreWorkspaces": [
    "packages/twenty-docs",
    "packages/twenty-front-component-renderer"
  ],
  "rules": {
    "binaries": "warn",
    "dependencies": "error",
    "devDependencies": "error",
    "duplicates": "warn",
    "enumMembers": "warn",
    "exports": "warn",
    "files": "error",
    "optionalPeerDependencies": "warn",
    "types": "warn",
    "unlisted": "warn",
    "unresolved": "warn"
  },
  "workspaces": {
    ".": {
      "ignoreDependencies": ["eslint-plugin-lingui"]
    },
    "packages/twenty-server": {
      "entry": [
        "src/main.ts",
        "src/command/command.ts",
        "src/queue-worker/queue-worker.ts",
        "src/database/scripts/*.ts",
        "src/database/clickhouse/migrations/run-migrations.ts",
        "src/database/clickhouse/seeds/run-seeds.ts",
        "src/instrument.ts",
        "src/engine/metadata-modules/ai/ai-front-component/utils/execute-front-component-builder-request.util.ts",
        "src/engine/metadata-modules/ai/ai-front-component/front-component-compiler.service.ts",
        "src/engine/core-modules/logic-function/logic-function-drivers/drivers/lambda/http-egress/http-egress-lambda.handler.ts",
        "src/engine/core-modules/logic-function/logic-function-drivers/drivers/lambda/sdk-client-generation/sdk-client-generation-lambda.handler.ts",
        "lingui.config.ts",
        "scripts/**/*.ts",
        "**/*.spec.ts",
        "**/*.integration-spec.ts",
        "test/integration/graphql/codegen/index.ts",
        "src/database/typeorm/core/legacy-typeorm-migrations-do-not-add/**/*.ts"
      ],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"],
      "jest": [
        "jest.config.mjs",
        "jest-integration.config.ts",
        "jest-integration-secure.config.ts"
      ],
      "ignore": [
        "src/**/constants/seed-project/**",
        "src/database/typeorm/core/migrations/**",
        "**/*.workspace-entity.ts",
        "src/engine/core-modules/logic-function/logic-function-resource/constants/**",
        "src/database/commands/upgrade-version-command/**",
        "src/engine/metadata-modules/*/constants/standard-*-names.ts",
        "src/engine/metadata-modules/*/constants/standard-*-titles.ts"
      ],
      "ignoreDependencies": ["@types/psl"]
    },
    "packages/twenty-front": {
      "entry": [
        "public/service-worker.js",
        "src/**/graphql/**/*.{ts,tsx}",
        "src/modules/geo-map/graphql-query/*.{ts,tsx}",
        "vitest.config.ts",
        "lingui.config.ts",
        "nyc.config.cjs",
        "jest-failures-only-reporter.cjs"
      ],
      "graphql-codegen": [
        "codegen.cjs",
        "codegen-admin.cjs",
        "codegen-metadata.cjs"
      ],
      "ignore": ["src/locales/generated/**", ".eloqnt/config.ts"],
      "ignoreDependencies": [
        "@babel/preset-typescript",
        "@storybook/addon-coverage",
        "buffer",
        "emojibase-data",
        "rollup-plugin-node-polyfills"
      ]
    },
    "packages/twenty-oxlint-rules": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["eslint", "eslint-plugin-lingui", "oxlint"]
    },
    "packages/twenty-ui": {
      "entry": ["scripts/**/*.ts", "docs/**/*.ts"],
      "ignore": ["src/styles/abstracts/**"],
      "ignoreDependencies": ["@storybook/addon-coverage", "@swc/core"]
    },
    "packages/create-twenty-app": {
      "ignoreDependencies": ["jest-environment-node"]
    },
    "packages/twenty-cli": {
      "entry": ["scripts/**/*.mjs"],
      "ignoreDependencies": ["vite-tsconfig-paths"]
    },
    "packages/twenty-companion": {
      "entry": ["lingui.config.ts"]
    },
    "packages/twenty-e2e-testing": {
      "entry": ["playwright.config.ts", "tests/**/*.ts", "reporters/**/*.ts"],
      "playwright": false
    },
    "packages/twenty-emails": {
      "ignoreDependencies": ["@lingui/swc-plugin"]
    },
    "packages/twenty-sdk": {
      "ignoreDependencies": ["preact"]
    },
    "packages/twenty-website": {
      "entry": ["lingui.config.ts", "wyw-in-js.config.cjs"],
      "ignoreDependencies": ["@lingui/swc-plugin"]
    },
    "packages/twenty-zapier": {
      "ignoreDependencies": ["jest-environment-node"]
    }
  }
}
