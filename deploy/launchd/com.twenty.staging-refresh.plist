<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.twenty.staging-refresh</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ben/Projects/twenty/deploy/refresh-staging-from-production.sh</string>
    <string>--yes</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ben/Projects/twenty</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Refresh before the workday. This intentionally replaces staging edits. -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>

  <key>StandardOutPath</key>
  <string>/tmp/twenty-staging-refresh.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/twenty-staging-refresh.log</string>
</dict>
</plist>
