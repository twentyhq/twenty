<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.twenty.production-converge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ben/Deploy/twenty/deploy/production-converge.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ben/Deploy/twenty</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- A production deploy is approved by a person who is then waiting on it, so
       the poll interval is exactly how long they wait. Five minutes was chosen
       partly to stop a failing convergence repeating quickly, but that does not
       happen: a convergence that merges and then fails its health check leaves
       current_sha == target_sha, so the next tick exits immediately. Only an
       un-fast-forwardable target retries, and that logs rather than acts.

       Use `launchctl kickstart -k gui/$(id -u)/com.twenty.production-converge`
       to deploy without waiting for the next tick. -->
  <key>StartInterval</key>
  <integer>60</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/twenty-production-converge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/twenty-production-converge.log</string>
</dict>
</plist>
