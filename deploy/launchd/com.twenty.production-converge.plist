<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.twenty.production-converge</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ben/Deploy/twenty/deploy/production-converge.sh</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/ben/Deploy/twenty</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <!-- Slower than staging on purpose. A production deploy is approved by a
       person who is watching, so there is no value in a tight poll, and a
       longer interval keeps a failing convergence from repeating quickly. -->
  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>StandardOutPath</key>
  <string>/tmp/twenty-production-converge.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/twenty-production-converge.log</string>
</dict>
</plist>
