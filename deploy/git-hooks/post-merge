#!/bin/bash
# Auto-sync the local backend DB schema + metadata cache after a pull/merge,
# whenever the merge touched server entities or instance-command migrations.
# Prevents the post-merge BLANK SCREEN caused by newly non-nullable GraphQL
# fields whose columns/flat-cache don't exist yet
# ("Cannot return null for non-nullable field ...").
# See deploy/update-after-merge.sh and deploy/LOCAL-DEV.md.
set -uo pipefail
REPO_ROOT="$(git rev-parse --show-toplevel)"

# Files changed by this merge (pre-merge HEAD is ORIG_HEAD).
changed="$(git diff-tree -r --name-only --no-commit-id ORIG_HEAD HEAD 2>/dev/null || true)"

# Herestring, NOT a pipe: `grep -q` exits at first match, and under pipefail a
# SIGPIPE'd printf made the whole pipeline "fail" -> schema merges were
# silently classified as no-schema and the DB sync skipped (bit us 2026-07-06).
if grep -qE 'packages/twenty-server/src/database/commands/upgrade-version-command/|\.entity\.ts$|packages/twenty-server/src/database/typeorm/' <<<"$changed"; then
  if [ "$REPO_ROOT" = "/Users/ben/Deploy/twenty" ]; then
    echo "[post-merge] backend schema files changed — syncing production schema"
    bash "$REPO_ROOT/deploy/update-after-merge.sh" \
      || echo "[post-merge] sync reported an error; run it manually: bash deploy/update-after-merge.sh"
  else
    echo "[post-merge] backend schema files changed — syncing local development schema"
    bash "$REPO_ROOT/deploy/local-schema.sh" sync \
      || echo "[post-merge] sync reported an error; run it manually: bash deploy/local-schema.sh sync"
  fi
else
  echo "[post-merge] no backend schema changes in this merge — skipping DB sync"
fi
