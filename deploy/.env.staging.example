# Copy to deploy/.env.staging. The real file is ignored by Git.
#
# Use the full commit SHA produced by build-custom-image.yml. Never use :latest.
STAGING_IMAGE=ghcr.io/speculativetechnologies/twenty:FULL_COMMIT_SHA
# GHCR currently publishes amd64. For an explicitly local arm64 build, use
# linux/arm64 and a local image tag.
STAGING_PLATFORM=linux/arm64
STAGING_PORT=3020
STAGING_SERVER_URL=https://spectech-llm.YOUR_TAILNET.ts.net:3020
STAGING_BIND_ADDRESS=127.0.0.1
# Active spectech-llm identity used by the tailnet-only HTTPS listener.
STAGING_TAILNET_ADDRESS=100.x.y.z
STAGING_TAILNET_HOSTNAME=spectech-llm.YOUR_TAILNET.ts.net

# Populate these from the production OAuth client using:
#   bash deploy/sync-staging-google-auth.sh
STAGING_AUTH_GOOGLE_ENABLED=false
STAGING_AUTH_GOOGLE_CLIENT_ID=
STAGING_AUTH_GOOGLE_CLIENT_SECRET=
STAGING_AUTH_GOOGLE_CALLBACK_URL=
STAGING_AUTH_GOOGLE_APIS_CALLBACK_URL=
STAGING_CALENDAR_PROVIDER_GOOGLE_ENABLED=false

# Generate each independently:
#   openssl rand -hex 32
STAGING_DATABASE_PASSWORD=CHANGE_ME
STAGING_ENCRYPTION_KEY=CHANGE_ME
